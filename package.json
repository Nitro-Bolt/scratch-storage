{
  "name": "@nitro-bolt/scratch-storage",
  "version": "1.0.3",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Nitro-Bolt/scratch-storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nitro-Bolt/scratch-storage.git"
  },
  "bugs": {
    "url": "https://github.com/Nitro-Bolt/scratch-storage/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/node/scratch-storage.js",
  "browser": "./dist/web/scratch-storage.js",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rspack build",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "test": "pnpm run test:lint && jest \"test[\\\\/](unit|integration)\"",
    "test:clearCache": "jest --clearCache",
    "test:lint": "eslint .",
    "test:integration": "jest \"test[\\\\/]integration\"",
    "test:unit": "jest \"test[\\\\/]unit\"",
    "watch": "rspack build --watch"
  },
  "tap": {
    "check-coverage": false
  },
  "dependencies": {
    "@turbowarp/nanolog": "1.0.1",
    "base64-js": "1.5.1",
    "cross-fetch": "4.1.0",
    "js-md5": "0.9.2"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "eslint": "8.57.1",
    "eslint-config-scratch": "9.0.3",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.5.2"
  }
}
